          "categoryID",
          "text",
          "title"
        ],
        "type": "object",
        "properties": {
          "newsID": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "title": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "text": {
            "maxLength": 5000,
            "minLength": 0,
            "type": "string"
          },
          "publicationDate": {
            "type": "string",
            "format": "date-time"
          },
          "imgDirUrl": {
            "type": "string",
            "nullable": true
          },
          "categoryID": {
            "type": "integer",
            "format": "int32"
          },
          "reactionCount": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "UserRegistrationModel": {
        "required": [

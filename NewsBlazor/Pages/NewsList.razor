@page "/news"
@using NewsBlazor.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>News List</h3>

<button class="btn btn-primary mb-3" @onclick="CreateNews">Create New News</button>

@if (newsList == null)
{
    <p>Loading...</p>
}
else if (!newsList.Any())
{
    <p>No news available.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Publication Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var news in newsList)
            {
                <tr>
                    <td>@news.NewsID</td>
                    <td>@news.Title</td>
                    <td>@news.PublicationDate.ToShortDateString()</td>
                    <td>
                        <button class="btn btn-sm btn-info me-2" @onclick="() => EditNews(news.NewsID)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteNews(news.NewsID)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    List<News> newsList;

    protected override async Task OnInitializedAsync()
    {
        await LoadNews();
    }

    private async Task LoadNews()
    {
        newsList = await Http.GetFromJsonAsync<List<News>>("api/news");
    }

    private void CreateNews()
    {
        Navigation.NavigateTo("/newsedit");
    }

    private void EditNews(long? id)
    {
        if (id.HasValue)
            Navigation.NavigateTo($"/newsedit/{id}");
    }

    private async Task DeleteNews(long? id)
    {
        if (id.HasValue && await JsRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete news #{id}?"))
        {
            var response = await Http.DeleteAsync($"api/news/{id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadNews();
            }
            else
            {
                // обробка помилки
            }
        }
    }

    [Inject]
    IJSRuntime JsRuntime { get; set; }
}

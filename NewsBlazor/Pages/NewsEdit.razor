@page "/newsedit"
@page "/newsedit/{NewsID:long}"
@using NewsBlazor.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>@(NewsID == null ? "Create News" : "Edit News")</h3>

<EditForm Model="newsItem" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Title:</label>
        <InputText @bind-Value="newsItem.Title" class="form-control" />
        <ValidationMessage For="@(() => newsItem.Title)" />
    </div>

    <div class="mb-3">
        <label>Text:</label>
        <InputTextArea @bind-Value="newsItem.Text" class="form-control" />
        <ValidationMessage For="@(() => newsItem.Text)" />
    </div>

    <div class="mb-3">
        <label>Publication Date:</label>
        <InputDate @bind-Value="newsItem.PublicationDate" class="form-control" />
        <ValidationMessage For="@(() => newsItem.PublicationDate)" />
    </div>

    <div class="mb-3">
        <label>Image URL:</label>
        <InputText @bind-Value="newsItem.ImgDirUrl" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Category ID:</label>
        <InputNumber @bind-Value="newsItem.CategoryID" class="form-control" />
        <ValidationMessage For="@(() => newsItem.CategoryID)" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancel</button>
</EditForm>

@code {
    [Parameter]
    public long? NewsID { get; set; }

    private News newsItem = new News();

    protected override async Task OnInitializedAsync()
    {
        if (NewsID.HasValue)
        {
            newsItem = await Http.GetFromJsonAsync<News>($"api/news/{NewsID}");
        }
    }

    private async Task HandleValidSubmit()
    {
        if (NewsID == null)
        {
            // Create
            var response = await Http.PostAsJsonAsync("api/news", newsItem);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/news");
            }
            else
            {
                // Handle error
            }
        }
        else
        {
            // Update
            var response = await Http.PutAsJsonAsync($"api/news/{NewsID}", newsItem);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/news");
            }
            else
            {
                // Handle error
            }
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/news");
    }
}

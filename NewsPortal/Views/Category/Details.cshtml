@model NewsPortal.Models.Category

@{
    ViewData["Title"] = "Деталі категорії";
}

<h1>Деталі</h1>

<div>
    <h4>Категорія</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Назва</dt>
        <dd class="col-sm-10">@Model.Name</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Редагувати</a>
<a asp-action="Index" class="btn btn-secondary">Назад</a>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

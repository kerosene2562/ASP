@model IEnumerable<NewsPortal.Models.News>

@{
    ViewData["Title"] = "News List";
}

<h1>News List</h1>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Publication Date</th>
            <th>Category ID</th>
            <th>Reactions</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var news in Model)
        {
            <tr>
                <td>@news.Title</td>
                <td>@news.PublicationDate.ToString("yyyy-MM-dd")</td>
                <td>@news.CategoryID</td>
                <td>
                    <button class="btn btn-sm btn-outline-primary" onclick="sendReaction(@news.NewsID)">
                        👍
                    </button>
                    <span id="reaction-@news.NewsID">@news.ReactionCount</span>
                </td>
                <td>
                    <a href="@Url.Action("Details", new { id = news.NewsID })">Details</a> |
                    <a href="@Url.Action("Edit", new { id = news.NewsID })">Edit</a> |
                    <a href="@Url.Action("Delete", new { id = news.NewsID })">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a href="@Url.Action("Create")" class="btn btn-primary">Create New News</a>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
                const connection = new signalR.HubConnectionBuilder()
            .withUrl("/newshub")
            .build();

        connection.on("ReceiveReaction", function(newsId, reactionCount) {
            const reactionSpan = document.getElementById(`reaction-${newsId}`);
            if (reactionSpan) {
                reactionSpan.textContent = reactionCount;
            }
        });

        connection.start().catch(function (err) {
            return console.error(err.toString());
        });

        function sendReaction(newsId) {
            connection.invoke("SendReaction", newsId).catch(function (err) {
                return console.error(err.toString());
            });
        }

    </script>
}

<!DOCTYPE html>
<html>
<head>
	<meta name="viewport" content="width=device-width" />
	<title>NewsPortal</title>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
	<style>
		body{
			margin: 0;
			padding: 0;
		}

		header{
			background-color: lightblue;
			height: 150px;
			text-align: center;
			padding-top: 1px;
		}

		.news-item{
			margin: 10px;
			background-color: grey;
			width: 150px;
		}

		.news-container {
			display: flex;
			width: 100%;
			justify-content: center;
		}

		#pagination-container{
			display: flex;
			margin-top: 20px;
			width: 100%;
			justify-content: center;
		}

		.pagination{
			background-color: orange;
			border: 1px solid black;
			border-radius: 5px;
			margin-left: 10px;
			padding-left: 5px;
			padding-right: 5px;
			text-align: center;
			text-decoration: none;
		}
		aside{
			width: 250px;
			height: 190px;
			border: 3px solid red;
			position: fixed; 
			left: 0;
			top: 150px;
			bottom: 0;
			overflow-y: auto;
		}
	</style>
</head>
<body>
	<header>
		<h1>NewsPortal</h1>
		<p>Останні новини з усього світу</p>
	</header>
	<aside>
		@await Component.InvokeAsync("NavigationMenu")
	</aside>
	<div>
		@RenderBody()
	</div>
</body>
</html>
